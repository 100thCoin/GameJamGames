  m_Script: {fileID: 11500000, guid: 18009248692df414a802c8833b5e3d2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  FailDuckGame:
  - ChetAnimation: 2
    Subtitles: Ohhhhh, it looks like Winnerman can't aim a gun!
    EndTimeline: 1
    Duration: 3
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face:
      - {fileID: 21300000, guid: 8612188abe10c174cb95a7f382900ac5, type: 3}
      - {fileID: 21300000, guid: b2d4e258e06e666429b48c66bfb90472, type: 3}
      - {fileID: 21300000, guid: 740ed74354aa6984991a3517ac47640b, type: 3}
      - {fileID: 21300000, guid: 740ed74354aa6984991a3517ac47640b, type: 3}
      Subtitles:
      - Wow, that duck moves fast!
      - I can't believe I missed.
      - Is there anything else I can shoot?
      - I'm starting to get fed up with this game show host.
      Clip:
      - {fileID: 8300000, guid: b6dfbfd6cb216ea4bab101bd502e5891, type: 3}
      - {fileID: 8300000, guid: 9d4280007eeed1c46a8d9cbb53a4fdd4, type: 3}
      - {fileID: 8300000, guid: 7608fcfced416f44cab2f9743c7ff056, type: 3}
      - {fileID: 8300000, guid: b67b53091124d924c9f85c93359b5693, type: 3}
      Seen: 0
    NextMinigame: {fileID: 0}
  ShootHostFail:
  - ChetAnimation: 4
    Subtitles: Winnerman...
    EndTimeline: 0
    Duration: 2
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 4
    Subtitles: Did you just try to shoot me?
    EndTimeline: 0
    Duration: 3
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 5
    Subtitles: While we were making EYE CONTACT?!
    EndTimeline: 0
    Duration: 3
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 5
    Subtitles: YOU ARE DISQUALIFIED!!!
    EndTimeline: 1
    Duration: 2
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 3
      Face:
      - {fileID: 21300000, guid: 8612188abe10c174cb95a7f382900ac5, type: 3}
      - {fileID: 21300000, guid: 8612188abe10c174cb95a7f382900ac5, type: 3}
      - {fileID: 21300000, guid: 740ed74354aa6984991a3517ac47640b, type: 3}
      Subtitles:
      - What was that about "eye contact"?
      - "I swear I've seen him break eye \ncontact with me before. ... but when?"
      - 'It''s when he laughs at me!

        Every time I''ve failed he''s closed his eye!'
      Clip:
      - {fileID: 8300000, guid: 7e5e867016e67f24b91cc171af0d3dd5, type: 3}
      - {fileID: 8300000, guid: a9fc66e1884237a4b9adb72e5ce827b5, type: 3}
      - {fileID: 8300000, guid: 5b03ad62914319e4a9bf8e2f875b9e40, type: 3}
      Seen: 0
    NextMinigame: {fileID: 0}
  ShootHostVictory:
  - ChetAnimation: 3
    Subtitles: You... You are a bold one.
    EndTimeline: 0
    Duration: 4
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 3
    Subtitles: 'Do you think I''m not aware of

      the SCAM you are pulling?'
    EndTimeline: 0
    Duration: 3
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 3
    Subtitles: 'Do you think you can come on to my game show

      and treat me with THIS MUCH disrepect?'
    EndTimeline: 0
    Duration: 4
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 0}
  - ChetAnimation: 3
    Subtitles: I am going to make you SUFFER!
    EndTimeline: 0
    Duration: 5
    AudioClip: {fileID: 0}
    InternalMonologue:
      Name: 
      Face: []
      Subtitles: []
      Clip: []
      Seen: 0
    NextMinigame: {fileID: 1126765231}
